# Copy to .env and edit for your deployment:  cp .env.example .env
#
# .env is gitignored -- it holds host-specific addresses and the dashboard
# token, none of which belong in the repository.

# --- Dashboard --------------------------------------------------------------
# Port the dashboard listens on. Host networking is used, so this is the port
# on the NAS itself; pick one nothing else has taken.
JOB_SCOUT_PORT=24817

# Leave empty for no authentication (anyone on the LAN can open the
# dashboard). Set a long random string to require a token.
JOB_SCOUT_DASHBOARD_TOKEN=

# --- Schedule ---------------------------------------------------------------
# Comma-separated day:HH:MM entries, evaluated in JOB_SCOUT_TZ.
JOB_SCOUT_SCHEDULE=tue:17:00,sat:03:00
JOB_SCOUT_TZ=Europe/Amsterdam

# --- Waking the LLM host ----------------------------------------------------
# The model server usually runs on a workstation that sleeps between runs.
# Before each scheduled run job-scout sends a wake-on-LAN magic packet to this
# MAC, then waits for the readiness URL below to answer.
#
# Leave JOB_SCOUT_WAKE_MAC empty to disable waking entirely (for example when
# the model server is always on).
JOB_SCOUT_WAKE_MAC=

# Use the subnet broadcast address rather than 255.255.255.255 where possible;
# some switches drop the all-ones address.
JOB_SCOUT_WAKE_BROADCAST=192.168.1.255

# Polled until it answers, so the pipeline does not start against a host that
# is still booting. This should be the model server's /v1/models endpoint.
JOB_SCOUT_LLM_HEALTH_URL=
