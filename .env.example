# Copy to .env and edit for your deployment:  cp .env.example .env
#
# .env is gitignored -- it holds host-specific addresses and the dashboard
# token, none of which belong in the repository.

# --- Dashboard --------------------------------------------------------------
# Port the dashboard listens on. Host networking is used, so this is the port
# on the NAS itself; pick one nothing else has taken.
JOB_SCOUT_PORT=24817

# Leave empty for no authentication (anyone on the LAN can open the
# dashboard). Set a long random string to require a token.
JOB_SCOUT_DASHBOARD_TOKEN=

# --- Container timezone -----------------------------------------------------
# Affects log timestamps. The schedule has its own timezone setting, managed
# in the dashboard.
JOB_SCOUT_TZ=Europe/Amsterdam

# --- Schedule and waking the LLM host ---------------------------------------
# These are NOT set here. They live in data/config.yaml and are managed from
# the dashboard, under Schedule -> Automatic runs:
#
#   - when to run (a row per day and time)
#   - the MAC of the machine hosting the model server, woken before each run
#   - its readiness URL, polled until it answers
#
# Setting JOB_SCOUT_SCHEDULE / JOB_SCOUT_WAKE_MAC / JOB_SCOUT_LLM_HEALTH_URL
# as environment variables still works and takes precedence, but then the
# dashboard can no longer change them -- so leave them unset unless you
# specifically want to pin a value.
